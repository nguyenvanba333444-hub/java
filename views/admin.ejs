<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tổng quan quản trị | Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head>
<body class="admin-body"><div class="admin-layout"><%- include('admin-nav',{active:'dashboard'}) %><main class="admin-main">
<header class="admin-topbar"><div><span class="admin-crumb">TRỌ TỐT <span>/</span> QUẢN TRỊ</span><h1>Tổng quan</h1></div><a class="admin-site-link" href="/">← Xem trang khách thuê</a></header>
<div class="admin-content"><section class="admin-welcome"><div><div class="admin-kicker">BẢNG ĐIỀU KHIỂN</div><h2>Xin chào, <%= user.fullName %></h2><p>Theo dõi tình hình tin đăng, tài khoản và yêu cầu thuê trong hệ thống.</p></div><span class="admin-date" id="adminDate"></span></section>
<section class="admin-stats"><a class="admin-stat stat-green" href="/admin/rooms"><div class="admin-stat-label">Tổng tin phòng<span>⌂</span></div><strong><%= counts.roomCount %></strong><small>Tin trên hệ thống</small></a><a class="admin-stat" href="/admin/rooms"><div class="admin-stat-label">Còn phòng<span>✓</span></div><strong><%= counts.availableCount %></strong><small>Có thể liên hệ thuê</small></a><a class="admin-stat" href="/admin/users"><div class="admin-stat-label">Tài khoản<span>♙</span></div><strong><%= counts.userCount %></strong><small>Người dùng và quản trị</small></a><a class="admin-stat" href="/admin/bookings"><div class="admin-stat-label">Yêu cầu thuê<span>▤</span></div><strong><%= counts.bookingCount %></strong><small>Tổng yêu cầu đã gửi</small></a><a class="admin-stat stat-amber" href="/admin/bookings"><div class="admin-stat-label">Đang chờ<span>◷</span></div><strong><%= counts.pendingCount %></strong><small>Cần theo dõi</small></a><a class="admin-stat" href="/admin/reviews"><div class="admin-stat-label">Đánh giá<span>★</span></div><strong><%= counts.reviewCount %></strong><small>Nhận xét về phòng</small></a></section>
<% if(counts.pendingCount>0){ %><a class="admin-alert" href="/admin/bookings"><span class="admin-alert-icon">!</span><span>Có <b><%= counts.pendingCount %></b> yêu cầu đang chờ xử lý.</span><b class="admin-alert-link">Xem yêu cầu →</b></a><% } %>
<section class="admin-section-head"><div><h2>Hoạt động gần đây</h2><p>Thông tin mới được ghi nhận trên hệ thống.</p></div><div class="admin-shortcuts"><a href="/admin/users">Tài khoản</a><a href="/admin/rooms">Tin phòng</a><a href="/admin/bookings">Yêu cầu thuê</a></div></section>
<section class="admin-panels"><article class="admin-panel"><div class="admin-panel-head"><div><h3>Tin phòng mới</h3><p>Các tin vừa đăng</p></div><a href="/admin/rooms">Tất cả →</a></div><div class="admin-activity" <% if(!recentRooms.length){ %>hidden<% } %>><% recentRooms.forEach(room=>{ %><div class="admin-row"><div class="admin-row-main"><b><%= room.title %></b><small><%= room.district %>, <%= room.city %> · <%= room.imageUrls.length %> ảnh</small></div><% if(room.imageUrls.length>=3){ %><a class="admin-pill" href="/room/<%= room.id %>">Xem tin</a><% } else { %><a class="admin-pill pill-warning" href="/room/<%= room.id %>/edit">Thiếu ảnh · Sửa</a><% } %></div><% }) %></div><% if(!recentRooms.length){ %><div class="admin-empty">Chưa có tin phòng.</div><% } %></article>
<article class="admin-panel"><div class="admin-panel-head"><div><h3>Tài khoản mới</h3><p>Người dùng vừa đăng ký</p></div><a href="/admin/users">Tất cả →</a></div><div class="admin-activity" <% if(!recentAccounts.length){ %>hidden<% } %>><% recentAccounts.forEach(account=>{ %><div class="admin-row"><div class="admin-avatar"><%= (account.full_name||'?').slice(0,1).toUpperCase() %></div><div class="admin-row-main"><b><%= account.full_name %></b><small><%= account.email %></small></div><span class="admin-pill"><%= account.role==='ADMIN'?'Admin':'Người dùng' %></span></div><% }) %></div><% if(!recentAccounts.length){ %><div class="admin-empty">Chưa có tài khoản.</div><% } %></article>
<article class="admin-panel"><div class="admin-panel-head"><div><h3>Yêu cầu thuê mới</h3><p>Các yêu cầu gần đây</p></div><a href="/admin/bookings">Tất cả →</a></div><div class="admin-activity" <% if(!recentBookings.length){ %>hidden<% } %>><% recentBookings.forEach(booking=>{ %><div class="admin-row"><div class="admin-row-main"><b>Yêu cầu #<%= booking.id %></b><small>Phòng #<%= booking.room_id %> · <%= booking.start_date %></small></div><span class="admin-pill <%= booking.status==='PENDING'?'pill-warning':booking.status==='REJECTED'?'pill-muted':'' %>"><%= booking.status==='PENDING'?'Đang chờ':booking.status==='CONFIRMED'?'Đã xác nhận':booking.status==='REJECTED'?'Đã từ chối':booking.status %></span></div><% }) %></div><% if(!recentBookings.length){ %><div class="admin-empty">Chưa có yêu cầu thuê.</div><% } %></article></section>
</div></main></div><script>document.getElementById('adminDate').textContent=new Intl.DateTimeFormat('vi-VN',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}).format(new Date())</script></body></html>
