<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= section==='users'?'Người dùng':section==='rooms'?'Tin phòng':section==='reviews'?'Đánh giá':'Yêu cầu thuê' %> | Quản trị Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head>
<body class="admin-body"><div class="admin-layout"><%- include('admin-nav',{active:section}) %><main class="admin-main">
<header class="admin-topbar"><div><span class="admin-crumb">QUẢN TRỊ <span>/</span> <%= section==='users'?'NGƯỜI DÙNG':section==='rooms'?'TIN PHÒNG':section==='reviews'?'ĐÁNH GIÁ':'YÊU CẦU THUÊ' %></span><h1><%= section==='users'?'Tài khoản người dùng':section==='rooms'?'Quản lý tin phòng':section==='reviews'?'Quản lý đánh giá':'Yêu cầu thuê' %></h1></div><a class="admin-site-link" href="/">← Trang khách thuê</a></header>
<div class="admin-content"><section class="admin-list-intro"><div><p><%= section==='users'?'Danh sách tài khoản đã đăng ký và quyền truy cập.':section==='rooms'?'Theo dõi tin đăng, số ảnh và trạng thái phòng.':section==='reviews'?'Xem và quản lý đánh giá của người dùng cho các phòng.':'Theo dõi yêu cầu thuê, tiền cọc và trạng thái đối soát.' %></p></div><span class="admin-total"><b><%= total %></b> mục</span></section>
<% if(notice){ %><p class="admin-notice"><span>✓</span><%= notice %></p><% } %>
<section class="admin-table-card"><div class="admin-table-toolbar"><label class="admin-search"><span>⌕</span><input id="search" type="search" placeholder="Tìm nhanh trong trang này…"></label><span class="admin-toolbar-note">Tối đa 10 mục mỗi trang</span></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr>
<% if(section==='users'){ %><th>TÀI KHOẢN</th><th>SỐ ĐIỆN THOẠI</th><th>QUYỀN</th>
<% } else if(section==='rooms'){ %><th>TIN ĐĂNG</th><th>CHỦ TIN</th><th>KHU VỰC</th><th>GIÁ / THÁNG</th><th>TÌNH TRẠNG</th><th>THAO TÁC</th>
<% } else if(section==='reviews'){ %><th>PHÒNG</th><th>NGƯỜI ĐÁNH GIÁ</th><th>SỐ SAO</th><th>NHẬN XÉT</th><th>NGÀY</th><th>THAO TÁC</th>
<% } else { %><th>MÃ</th><th>PHÒNG / TIỀN CỌC</th><th>NGƯỜI THUÊ</th><th>THỜI GIAN</th><th>TRẠNG THÁI</th><th>XỬ LÝ</th><% } %>
</tr></thead><tbody id="rows"><% items.forEach(item=>{ %><tr>
<% if(section==='users'){ %><td><div class="admin-user-cell"><span class="admin-avatar"><%= (item.full_name||'?').slice(0,1).toUpperCase() %></span><span><b><%= item.full_name %></b><small><%= item.email %></small></span></div></td><td><%= item.phone %></td><td><span class="admin-pill <%= item.role==='ADMIN'?'pill-admin':'' %>"><%= item.role==='ADMIN'?'Quản trị viên':'Người dùng' %></span></td>
<% } else if(section==='rooms'){ %><td><div class="admin-cell-title"><b><%= item.title %></b><small>Mã tin #<%= item.id %> · <%= item.imageUrls.length %> ảnh</small><% if(item.imageUrls.length<3){ %><small class="admin-warning-text">Thiếu ảnh — cần tối thiểu 3</small><% } %></div></td><td><%= item.owner_name %></td><td><%= item.district %>, <%= item.city %></td><td class="admin-price"><%= Number(item.price).toLocaleString('vi-VN') %> đ</td><td><span class="admin-pill <%= item.available?'pill-green':'pill-muted' %>"><%= item.available?'Còn phòng':'Đã thuê' %></span></td><td><div class="admin-actions"><% if(item.imageUrls.length>=3){ %><a href="/room/<%= item.id %>">Xem</a><% } %><a href="/room/<%= item.id %>/edit">Sửa</a><form method="post" action="/room/<%= item.id %>/delete" onsubmit="return confirm('Xóa tin phòng này?')"><button class="admin-delete">Xóa</button></form></div></td>
<% } else if(section==='reviews'){ %><td><b><%= item.room_title %></b><small class="admin-cell-sub">Phòng #<%= item.room_id %></small></td><td><b><%= item.user_name %></b><small class="admin-cell-sub"><%= item.email %></small></td><td class="review-stars"><%= '★'.repeat(Number(item.rating)) %><%= '☆'.repeat(5-Number(item.rating)) %></td><td><%= item.comment||'—' %></td><td><%= new Date(item.updated_at||item.created_at).toLocaleDateString('vi-VN') %></td><td><div class="admin-actions"><a href="/room/<%= item.room_id %>">Xem phòng</a><form method="post" action="/admin/reviews/<%= item.id %>/delete" onsubmit="return confirm('Xóa đánh giá này?')"><button class="admin-delete">Xóa</button></form></div></td>
<% } else { %><td><b>#<%= item.id %></b></td><td><b><%= item.room_title||'Phòng đã xóa' %></b><small class="admin-cell-sub"><%= item.payment_method==='CASH'?'Tiền mặt khi xem phòng':'Chuyển khoản QR' %> · cọc <%= Number(item.deposit_amount||0).toLocaleString('vi-VN') %> đ · mã <%= item.payment_code||'—' %></small></td><td><b><%= item.tenant_name %></b><small class="admin-cell-sub"><%= item.phone %></small></td><td><%= item.start_date %><small class="admin-cell-sub">đến <%= item.end_date %></small></td><td><span class="admin-pill <%= item.status==='PENDING'?'pill-warning':item.status==='REJECTED'?'pill-muted':'pill-green' %>"><%= item.status==='PENDING'?'Đang chờ':item.status==='CONFIRMED'?'Đã xác nhận':item.status==='REJECTED'?'Đã từ chối':item.status %></span><small class="admin-cell-sub">Cọc: <%= item.payment_status==='PAID'?'Đã nhận':item.payment_status==='PENDING'?(item.payment_method==='CASH'?'Chờ thu tiền mặt':'Chờ đối soát'):item.payment_method==='CASH'?'Thanh toán tiền mặt':'Chưa cấu hình QR' %></small></td><td><div class="admin-actions"><% if(item.status==='PENDING'){ %><form method="post" action="/booking/<%= item.id %>/status"><button name="status" value="CONFIRMED" class="admin-approve">Xác nhận thuê</button><button name="status" value="REJECTED" class="admin-delete">Từ chối</button></form><% } %><% if(item.payment_status==='PENDING'){ %><form method="post" action="/booking/<%= item.id %>/payment"><button name="paymentStatus" value="PAID" class="admin-approve">Đã nhận cọc</button><button name="paymentStatus" value="PENDING" class="admin-delete">Chưa nhận</button></form><% } %></div></td><% } %>
</tr><% }) %></tbody></table>
<% if(!items.length){ %><div class="admin-empty">Danh sách này hiện chưa có dữ liệu.</div><% } %><div class="admin-search-empty" id="noSearchResults" hidden>Không tìm thấy mục phù hợp trên trang hiện tại.</div></div>
<footer class="admin-table-footer"><span>Đang xem <b><%= start %>–<%= end %></b> / <b><%= total %></b> · Trang <b><%= page+1 %></b> / <b><%= totalPages||1 %></b></span><nav class="admin-pagination" aria-label="Phân trang"><% if(page>0){ %><a href="?page=0">«</a><a href="?page=<%= page-1 %>">‹</a><% } %><% for(let p=Math.max(0,page-2);p<Math.min(totalPages,page+3);p++){ %><a class="<%= p===page?'current':'' %>" href="?page=<%= p %>"><%= p+1 %></a><% } %><% if(page+1<totalPages){ %><a href="?page=<%= page+1 %>">›</a><a href="?page=<%= totalPages-1 %>">»</a><% } %></nav></footer></section></div></main></div>
<script>const search=document.getElementById('search'),rows=[...document.querySelectorAll('#rows tr')],empty=document.getElementById('noSearchResults');search.addEventListener('input',()=>{const query=search.value.toLocaleLowerCase('vi');let shown=0;rows.forEach(row=>{row.hidden=!row.textContent.toLocaleLowerCase('vi').includes(query);if(!row.hidden)shown++;});empty.hidden=shown!==0||rows.length===0;});</script></body></html>
