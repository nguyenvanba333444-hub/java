<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trọ Tốt - Tìm phòng trọ</title><link rel="stylesheet" href="/public/app.css"></head>
<body><%- include('header') %><main class="wrap">
<section class="hero"><p class="muted">TÌM PHÒNG TRỌ DỄ DÀNG</p><h1>Tìm nơi ở phù hợp với bạn</h1><p class="muted">Các phòng được tải trực tiếp từ API phòng của hệ thống.</p></section>
<form class="search" id="roomSearch"><input type="search" name="city" value="<%= city || '' %>" placeholder="Tỉnh / thành phố"><input type="number" name="minPrice" min="0" placeholder="Giá từ" value="<%= minPrice || '' %>"><input type="number" name="maxPrice" min="0" placeholder="Giá đến" value="<%= maxPrice || '' %>"><button class="button">Tìm phòng</button></form>
<p class="muted" id="roomCount">Đang tải phòng từ API…</p><section class="grid" id="roomList" aria-live="polite"></section><nav class="pagination" id="pages" aria-label="Phân trang phòng"></nav>
</main>
<script>
const form=document.getElementById('roomSearch'),list=document.getElementById('roomList'),count=document.getElementById('roomCount'),pages=document.getElementById('pages');
let apiRooms=[],page=0;const pageSize=9,signedIn=<%= user ? 'true' : 'false' %>;let favorites=new Set();
function node(tag,cls,text){const el=document.createElement(tag);if(cls)el.className=cls;if(text!==undefined)el.textContent=text;return el}
function render(){list.replaceChildren();count.textContent=apiRooms.length+' phòng có ít nhất 3 ảnh';const total=Math.ceil(apiRooms.length/pageSize);page=Math.min(page,Math.max(total-1,0));const visible=apiRooms.slice(page*pageSize,(page+1)*pageSize);if(!visible.length){list.append(node('p','card pad','Chưa có phòng phù hợp hoặc phòng chưa đủ 3 ảnh.'));}visible.forEach(room=>{const article=node('article','card'),link=node('a');link.href='/room/'+encodeURIComponent(room.id);const photo=node('div','photo'),img=node('img');img.src=room.imageUrls[0];img.alt='Ảnh phòng: '+room.title;img.loading='lazy';photo.append(img);const body=node('div','pad');body.append(node('div','room-title',room.title),node('p','muted',(room.district||'')+', '+(room.city||'')),node('p','price',Number(room.price).toLocaleString('vi-VN')+' đ / tháng'),node('span','muted',room.imageUrls.length+' ảnh · '+(room.area||0)+' m² · '+(room.available?'Còn phòng':'Đã thuê')));link.append(photo,body);const save=node('button','button secondary favorite-button',favorites.has(room.id)?'♥ Đã lưu':'♡ Lưu phòng');save.type='button';save.addEventListener('click',async()=>{if(!signedIn){location.href='/login';return;}const removing=favorites.has(room.id);const result=await fetch('/api/favorites/'+room.id,{method:removing?'DELETE':'POST',headers:{Accept:'application/json'}});if(result.status===401){location.href='/login';return;}if(!result.ok)return;removing?favorites.delete(room.id):favorites.add(room.id);save.textContent=removing?'♡ Lưu phòng':'♥ Đã lưu';});article.append(link,save);list.append(article);});pages.replaceChildren();if(total>1){for(let n=0;n<total;n++){const a=node('a',n===page?'active':'',String(n+1));a.href='#';a.addEventListener('click',e=>{e.preventDefault();page=n;render();document.getElementById('roomList').scrollIntoView({behavior:'smooth',block:'start'});});pages.append(a);}}}
async function load(){const query=new URLSearchParams(new FormData(form));for(const [k,v] of [...query])if(!v)query.delete(k);count.textContent='Đang tải phòng từ API…';try{if(signedIn){try{const favoriteResponse=await fetch('/api/favorites',{headers:{Accept:'application/json'}});if(favoriteResponse.ok){const saved=await favoriteResponse.json();favorites=new Set(saved.map(room=>room.id));}}catch{favorites.clear();}}const response=await fetch('/api/rooms?'+query.toString(),{headers:{Accept:'application/json'}});if(!response.ok)throw new Error();const data=await response.json();apiRooms=Array.isArray(data)?data:[];page=0;render();}catch{list.replaceChildren(node('p','card pad','Không tải được danh sách phòng từ API. Hãy kiểm tra kết nối rồi tải lại.'));count.textContent='';pages.replaceChildren();}}
form.addEventListener('submit',e=>{e.preventDefault();const params=new URLSearchParams(new FormData(form));for(const [k,v] of [...params])if(!v)params.delete(k);history.replaceState(null,'','/'+(params.size?'?'+params.toString():''));load();});load();
</script></body></html>
