<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tài khoản của tôi | Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head><body><%- include('header') %><main class="auth"><h1>Thông tin tài khoản</h1><% if(complete){ %><p class="notice">Đăng nhập mạng xã hội thành công. Hãy thêm số điện thoại để chủ trọ có thể liên hệ với bạn.</p><% } %><% if(querySaved){ %><p class="notice">Đã lưu thông tin.</p><% } %><% if(error){ %><p class="error"><%= error %></p><% } %><form method="post" action="/profile"><label class="field">Họ và tên<input name="fullName" maxlength="120" required value="<%= account.full_name %>"></label><label class="field">Email đăng nhập<input type="email" readonly value="<%= account.email %>"></label><label class="field">Số điện thoại<input name="phone" type="tel" minlength="8" maxlength="20" required value="<%= account.phone %>" placeholder="Nhập số điện thoại"></label><button class="button">Lưu thông tin</button></form></main></body></html>
