<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Phòng yêu thích | Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head>
<body><%- include('header') %><main class="wrap container"><h1>Phòng yêu thích</h1><p class="muted">Danh sách này được lưu theo tài khoản của bạn.</p><p id="favoriteCount" class="muted">Đang tải…</p><section id="favoriteList" class="grid" aria-live="polite"></section></main>
<script>
const list=document.getElementById('favoriteList'),count=document.getElementById('favoriteCount');
function el(tag,cls,text){const node=document.createElement(tag);if(cls)node.className=cls;if(text!==undefined)node.textContent=text;return node;}
async function loadFavorites(){try{const response=await fetch('/api/favorites',{headers:{Accept:'application/json'}});if(response.status===401){location.href='/login';return;}if(!response.ok)throw new Error();const rooms=await response.json();count.textContent=rooms.length+' phòng đã lưu';list.replaceChildren();if(!rooms.length){list.append(el('p','card pad','Bạn chưa lưu phòng nào. Hãy chọn “Lưu phòng” ở danh sách tìm kiếm.'));return;}rooms.forEach(room=>{const card=el('article','card'),link=el('a');link.href='/room/'+room.id;const photo=el('div','photo'),img=el('img');img.src=room.imageUrls[0];img.alt='Ảnh phòng: '+room.title;photo.append(img);const body=el('div','pad');body.append(el('div','room-title',room.title),el('p','muted',room.district+', '+room.city),el('p','price',Number(room.price).toLocaleString('vi-VN')+' đ / tháng'),el('span','muted',room.imageUrls.length+' ảnh · '+room.area+' m²'));link.append(photo,body);const remove=el('button','button secondary favorite-button','Bỏ yêu thích');remove.type='button';remove.addEventListener('click',async()=>{const result=await fetch('/api/favorites/'+room.id,{method:'DELETE',headers:{Accept:'application/json'}});if(result.ok)loadFavorites();});card.append(link,remove);list.append(card);});}catch{count.textContent='Không tải được danh sách yêu thích.';}}
loadFavorites();
</script></body></html>
