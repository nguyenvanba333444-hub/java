<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tạo tài khoản | Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head><body><%- include('header') %><main class="auth"><a class="brand" href="/">⌂ trọ tốt</a><h1>Tạo tài khoản</h1><p class="muted">Một tài khoản dùng chung để tìm thuê phòng và đăng tin cho thuê.</p><% if(error){ %><p class="error"><%= error %></p><% } %><form method="post" action="/register"><label class="field">Họ và tên<input name="fullName" required maxlength="120" value="<%= values.fullName||'' %>"></label><label class="field">Số điện thoại<input name="phone" required pattern="[+0-9 .()\-]{8,20}" value="<%= values.phone||'' %>"></label><label class="field">Email<input type="email" name="email" required value="<%= values.email||'' %>"></label><label class="field">Mật khẩu (ít nhất 8 ký tự)<input type="password" name="password" minlength="8" required></label><button class="button" style="width:100%">Tạo tài khoản</button></form><p class="muted">Đã có tài khoản? <a href="/login">Đăng nhập</a></p></main></body></html>
