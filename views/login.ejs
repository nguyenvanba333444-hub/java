<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng nhập | Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head><body><%- include('header') %><main class="auth"><a class="brand" href="/">⌂ trọ tốt</a><h1>Đăng nhập</h1><p class="muted">Chủ trọ, khách thuê và quản trị viên dùng chung trang đăng nhập.</p><% if(registered){ %><p class="notice">Tạo tài khoản thành công. Bạn có thể đăng nhập.</p><% } %><% if(oauthError){ %><p class="error">Đăng nhập mạng xã hội chưa cấu hình hoặc không hoàn tất. Hãy kiểm tra khóa ứng dụng trong file .env hoặc đăng nhập bằng email.</p><% } %><% if(error){ %><p class="error"><%= error %></p><% } %><form method="post" action="/login"><label class="field">Email<input type="email" name="email" required></label><label class="field">Mật khẩu<input type="password" name="password" required></label><button class="button" style="width:100%">Đăng nhập</button></form><% if(oauthAvailable.google||oauthAvailable.facebook){ %><div class="oauth-divider">Hoặc đăng nhập nhanh</div><div class="oauth-buttons"><% if(oauthAvailable.google){ %><a class="button secondary" href="/auth/google">Tiếp tục với Google</a><% } %><% if(oauthAvailable.facebook){ %><a class="button secondary" href="/auth/facebook">Tiếp tục với Facebook</a><% } %></div><% } %><p class="muted">Chưa có tài khoản? <a href="/register">Đăng ký</a></p></main></body></html>
