<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết phòng | Trọ Tốt</title><link rel="stylesheet" href="/public/app.css"></head>
<body><%- include('header') %><main class="container"><a href="/">← Tìm phòng</a><div id="roomDetails" class="card pad" aria-live="polite">Đang tải thông tin phòng từ API…</div><section id="roomEngagement" class="card pad room-engagement" data-room-id="<%= roomId %>" data-signed-in="<%= user?'true':'false' %>" data-can-review="<%= user?.role==='USER'?'true':'false' %>">Đang tải yêu thích và đánh giá…</section></main>
<script src="/public/room-engagement.js?v=2" defer></script><script>document.querySelector('script[src^="/public/room-engagement.js"]').addEventListener('error',()=>{document.getElementById('roomEngagement').textContent='Không tải được phần đánh giá. Hãy tải lại trang.';});</script>
<script>
const roomId=<%= roomId %>,signedIn=<%= user ? 'true' : 'false' %>,bankTransferEnabled=<%= bankTransferEnabled ? 'true' : 'false' %>,googleMapsEmbedApiKey=<%- JSON.stringify(googleMapsEmbedApiKey || '') %>,host=document.getElementById('roomDetails');
function add(tag,cls,text){const e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=text;return e;}
async function loadRoom(){try{const response=await fetch('/api/rooms/'+roomId,{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Phòng không tồn tại hoặc tin chưa có đủ 3 ảnh.');const room=await response.json();document.title=room.title+' | Trọ Tốt';host.replaceChildren();const title=add('h1','',room.title),location=add('p','muted',[room.address,room.district,room.city].filter(Boolean).join(', ')),gallery=add('div','grid');(room.mediaUrls||room.imageUrls.map(url=>({url,type:'IMAGE'}))).forEach((media,index)=>{const frame=add('div','card photo');if(media.type==='VIDEO'){const video=add('video');video.src=media.url;video.controls=true;video.preload='metadata';frame.append(video);}else{const img=add('img');img.src=media.url;img.alt='Ảnh '+(index+1)+' - '+room.title;frame.append(img);}gallery.append(frame);});const price=add('p','price',Number(room.price).toLocaleString('vi-VN')+' đ / tháng · '+room.area+' m²'),description=add('p','',room.description||'Chủ trọ chưa thêm mô tả.'),contact=add('section','card pad');contact.append(add('h2','','Liên hệ chủ trọ'));const errorCode=new URLSearchParams(window.location.search).get('error'),bookingErrors={dates:'Ngày thuê không hợp lệ hoặc đã qua.',duplicate:'Khoảng thời gian này đã có yêu cầu thuê đang chờ hoặc đã xác nhận.',payment:'Phương thức thanh toán chưa được cấu hình hoặc không hợp lệ.',room:'Phòng này không còn nhận yêu cầu thuê.'};if(bookingErrors[errorCode])contact.append(add('p','error',bookingErrors[errorCode]));if(signedIn){contact.append(add('p','muted',(room.owner?.fullName||'Chủ trọ')+' · '+(room.owner?.phone||'Chưa có số điện thoại')));}else{contact.append(add('p','muted','Đăng nhập để xem thông tin liên hệ của chủ trọ.'));contact.append(Object.assign(add('a','button','Đăng nhập'),{href:'/login'}));}if(signedIn&&room.available){const form=add('form','actions');form.method='post';form.action='/room/'+room.id+'/book';const payment=add('label','field','Phương thức thanh toán'),paymentInput=add('select');paymentInput.name='paymentMethod';if(bankTransferEnabled){const bankOption=add('option','','Chuyển khoản qua QR');bankOption.value='BANK_TRANSFER';paymentInput.append(bankOption);}const cashOption=add('option','','Tiền mặt khi xem phòng');cashOption.value='CASH';paymentInput.append(cashOption);payment.append(paymentInput);const start=add('label','field','Ngày bắt đầu'),startInput=add('input');startInput.type='date';startInput.name='startDate';startInput.required=true;const end=add('label','field','Ngày kết thúc'),endInput=add('input');endInput.type='date';endInput.name='endDate';endInput.required=true;start.append(startInput);end.append(endInput);const button=add('button','button','Gửi yêu cầu thuê');form.append(payment,start,end,button);contact.append(form);}else if(!room.available){contact.append(add('p','muted','Phòng này hiện đã được thuê.'));}const map=add('section','card pad room-map'),mapTitle=add('h2','','Vị trí và khoảng cách'),mapControls=add('div','map-distance-controls'),target=add('input');target.placeholder='Nhập trường học, công ty hoặc địa điểm cần đến';target.setAttribute('aria-label','Địa điểm cần tính khoảng cách');const distanceButton=add('button','button secondary','Tính khoảng cách');distanceButton.type='button';const distanceText=add('p','muted','Bản đồ Google Maps'),mapFrame=add('iframe');mapFrame.title='Bản đồ Google Maps';mapFrame.loading='lazy';mapFrame.referrerPolicy='strict-origin-when-cross-origin';mapFrame.hidden=false;const mapLink=add('a','button secondary','Mở vị trí trên Google Maps');mapLink.target='_blank';mapLink.rel='noopener';mapControls.append(target,distanceButton);map.append(mapTitle,mapControls,distanceText,mapFrame,mapLink);let point=room.latitude&&room.longitude?{latitude:Number(room.latitude),longitude:Number(room.longitude)}:null;async function lookupPlace(q){const res=await fetch('/api/geocode?q='+encodeURIComponent(q));if(res.ok)return res.json();const external=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=vn&q='+encodeURIComponent(q));const list=await external.json();if(!list[0])throw new Error('Không tìm thấy địa điểm. Hãy nhập tên cụ thể hơn.');return{latitude:Number(list[0].lat),longitude:Number(list[0].lon),label:list[0].display_name};}async function ensurePoint(){if(point)return point;const q=[room.address,room.district,room.city].filter(Boolean).join(', ');point=await lookupPlace(q);return point;}async function showMap(a,b){const pointQuery=a.latitude+','+a.longitude;mapLink.href='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(pointQuery);if(googleMapsEmbedApiKey){mapFrame.src='https://www.google.com/maps/embed/v1/place?key='+encodeURIComponent(googleMapsEmbedApiKey)+'&q='+encodeURIComponent(pointQuery);}else{mapFrame.src='https://maps.google.com/maps?q='+encodeURIComponent(pointQuery)+'&output=embed';}}ensurePoint().then(p=>showMap(p)).catch(error=>distanceText.textContent=error.message);distanceButton.addEventListener('click',async()=>{try{distanceButton.disabled=true;const origin=await ensurePoint(),dest=await lookupPlace(target.value),rad=x=>x*Math.PI/180,R=6371,dLat=rad(dest.latitude-origin.latitude),dLon=rad(dest.longitude-origin.longitude),h=Math.sin(dLat/2)**2+Math.cos(rad(origin.latitude))*Math.cos(rad(dest.latitude))*Math.sin(dLon/2)**2,km=2*R*Math.asin(Math.sqrt(h));distanceText.textContent=`Khoảng cách đường chim bay: ${km.toFixed(1)} km · vị trí đích: ${dest.label}`;await showMap(origin,dest);}catch(error){distanceText.textContent=error.message;}finally{distanceButton.disabled=false;}});host.append(title,location,gallery,price,description,map,contact);}catch(error){host.classList.add('error');host.textContent=error.message||'Không tải được thông tin phòng.';}}
loadRoom();
</script></body></html>
