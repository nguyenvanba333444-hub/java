<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý tin phòng</title><link rel="stylesheet" href="/public/app.css"></head><body><%- include('header') %><main class="container"><h1>Quản lý phòng trọ</h1><% if(notice){ %><p class="notice"><%= notice %></p><% } %><% if(user.role==='ADMIN'){ %><form class="actions" method="get" action="/manage"><select name="ownerId"><option value="0">Chọn chủ trọ</option><% owners.forEach(owner=>{ %><option value="<%= owner.id %>" <%= ownerId===owner.id?'selected':'' %>><%= owner.full_name %> · <%= owner.phone %></option><% }) %></select><button class="button">Xem</button></form><% } %><p><a class="button" href="/room/new">＋ Đăng tin phòng</a></p><h2>Tin đã đăng</h2><div class="tablebox"><table><thead><tr><th>Tin phòng</th><th>Khu vực</th><th>Giá thuê</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% rooms.forEach(room=>{ %><tr><td><b><%= room.title %></b><br><%= room.area %> m² · <%= room.address %></td><td><%= room.district %>, <%= room.city %></td><td><%= Number(room.price).toLocaleString('vi-VN') %> đ</td><td><%= room.available?'Còn phòng':'Đã thuê' %></td><td class="actions"><a href="/room/<%= room.id %>/edit">Sửa</a><form method="post" action="/room/<%= room.id %>/delete" onsubmit="return confirm('Xóa tin phòng này?')"><button class="button">Xóa</button></form></td></tr><% }) %></tbody></table></div><% if(!rooms.length){ %><p class="muted">Chưa có tin phòng.</p><% } %><h2>Yêu cầu thuê</h2><div class="tablebox"><table><thead><tr><th>Người thuê</th><th>Phòng</th><th>Thời gian</th><th>Trạng thái</th><th>Xử lý</th></tr></thead><tbody><% requests.forEach(request=>{ %><tr><td><%= request.tenant_name||'Người thuê' %><br><%= request.phone||'' %></td><td><%= request.room_title %></td><td><%= request.start_date %> – <%= request.end_date %></td><td><%= request.status %></td><td><% if(request.status==='PENDING'){ %><form class="actions" method="post" action="/booking/<%= request.id %>/status"><button class="button" name="status" value="CONFIRMED">Xác nhận</button><button class="button secondary" name="status" value="REJECTED">Từ chối</button></form><% } %></td></tr><% }) %></tbody></table></div><% if(!requests.length){ %><p class="muted">Chưa có yêu cầu thuê.</p><% } %></main></body></html>
